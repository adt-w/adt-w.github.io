---
/**
 * The document shell: head, fonts, global styles, masthead, footer.
 */
import { Font } from 'astro:assets';

import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollSpy from '../components/ScrollSpy.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />

		{/* Matches the browser chrome to the page ground. Dark is the default,
		    so it is the value shipped; the toggle rewrites it when a reader
		    switches to light. */}
		<meta name="theme-color" content="#111113" data-theme-color />

		{/* Emits @font-face rules, the --font-* variables and preload links.
		    Self-hosted and subsetted — no third-party request at runtime. */}
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" preload />

		{/* Runs before first paint so a saved light choice never flashes dark.
		    Inline and synchronous on purpose: deferring it is the flash.
		    With nothing saved the page stays on its default dark scheme. */}
		<script is:inline>
			try {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') {
					document.documentElement.dataset.theme = saved;
				}
			} catch {
				/* Storage blocked — the default scheme stands. */
			}
		</script>

		{/* Decides, before anything paints, whether content may start hidden for
		    the scroll reveal. Hiding it later would flash it on and then off.
		    Skipped entirely without IntersectionObserver or when the reader
		    prefers reduced motion. The timeout is a safety net: if the reveal
		    script has not started within 2.5s (blocked, failed to load), the
		    class comes off and everything simply shows. */}
		<script is:inline>
			if (
				'IntersectionObserver' in window &&
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				const root = document.documentElement;
				root.classList.add('js-reveal');
				setTimeout(() => {
					if (!root.dataset.revealReady) root.classList.remove('js-reveal');
				}, 2500);
			}
		</script>
	</head>

	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<Masthead />

		<main id="main" class="page">
			<slot />
		</main>

		<SiteFooter />
		<ScrollSpy />
		<ScrollReveal />
	</body>
</html>
