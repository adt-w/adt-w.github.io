---
/**
 * PLACEHOLDER — replaced in commit 3 by the real page.
 *
 * Its only job right now is to exercise the design system end to end so the
 * type scale, colour, grid and both primitives can be seen rendering before
 * any content work starts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import LedgerRow from '../components/LedgerRow.astro';
---

<BaseLayout
	title="Aditya Wadhwa"
	description="Management Engineering student at the University of Waterloo working on data systems and machine learning."
>
	<main id="main" class="page">
		<h1 class="masthead">Aditya<br />Wadhwa</h1>

		<Section index="01" title="Experience" id="experience" note="3 entries">
			<LedgerRow label="2026.05 — 2026.08" sublabel="Ottawa, ON" rule={false}>
				<h3 class="entry__title">Privy Council Office</h3>
				<p class="entry__role">Student Data Analyst</p>
			</LedgerRow>

			<LedgerRow label="2021.09 — 2024.05" sublabel="Ottawa, ON">
				<h3 class="entry__title">Sparks Youth Robotics Club</h3>
				<p class="entry__role">Mechanical Lead</p>
			</LedgerRow>
		</Section>

		<Section index="02" title="Type specimen" id="specimen">
			<p class="lead u-measure-wide">
				A lead paragraph sits at eighteen pixels and a comfortable measure.
				Hierarchy on this site is built from size, weight, space and hairline
				rules — never from gradients, shadows or motion.
			</p>
			<p class="u-measure body">
				Body copy runs at sixteen pixels over roughly sixty characters, which
				is where sustained reading stays comfortable. Links such as
				<a href="https://github.com/adt-w">this one</a> carry an underline at all
				times, so colour is never the only thing marking them.
			</p>
		</Section>
	</main>
</BaseLayout>

<style>
	.masthead {
		padding-block: var(--s-9) var(--s-7);
		font-size: var(--fs-display);
		font-weight: var(--fw-medium);
		line-height: var(--lh-display);
		letter-spacing: var(--tr-display);
	}

	.entry__title {
		font-size: var(--fs-lg);
		font-weight: var(--fw-medium);
	}

	.entry__role {
		margin-block-start: var(--s-1);
		color: var(--ink-2);
	}

	.lead {
		font-size: var(--fs-md);
		line-height: var(--lh-snug);
		color: var(--ink);
	}

	.body {
		margin-block-start: var(--s-5);
		color: var(--ink-2);
	}
</style>