---
/**
 * The single page.
 *
 * Everything here is driven by the content collections — the section counts,
 * the ordering and the chronology all derive from the markdown files in
 * src/content/. Adding a project means adding a file; this page does not
 * change.
 */
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import Chronology from '../components/Chronology.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import EducationEntry from '../components/EducationEntry.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { site, contact } from '../data/site';
import { byNewest } from '../lib/dates';
import { url } from '../lib/url';

const [experienceRaw, projectsRaw, educationRaw] = await Promise.all([
	getCollection('experience'),
	getCollection('projects'),
	getCollection('education'),
]);

const experience = experienceRaw.sort((a, b) => byNewest(a.data, b.data));
const education = educationRaw.sort((a, b) => byNewest(a.data, b.data));

/**
 * Featured projects lead, then the rest by date. Sorting featured to the top
 * rather than into a separate section keeps one chronological list, so a
 * reader never has to check two places for the same kind of thing.
 */
const projects = projectsRaw.sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return byNewest(a.data, b.data);
});

const activeCount = projects.filter((p) => p.data.status === 'active').length;
---

<BaseLayout title={site.title} description={site.description}>
	<Hero />

	<Section
		index="01"
		title="Chronology"
		id="chronology"
		note={`${experience.length + projects.length + education.length} entries`}
	>
		<Chronology />
	</Section>

	<Section
		index="02"
		title="Experience"
		id="experience"
		note={`${experience.length} roles`}
	>
		{
			experience.map((entry, i) => (
				<ExperienceEntry entry={entry} first={i === 0} />
			))
		}
	</Section>

	<Section
		index="03"
		title="Projects"
		id="projects"
		note={activeCount > 0 ? `${projects.length} · ${activeCount} in progress` : `${projects.length}`}
	>
		{projects.map((entry, i) => <ProjectEntry entry={entry} first={i === 0} />)}
	</Section>

	<Section index="04" title="Skills" id="skills">
		<SkillsGrid />
	</Section>

	<Section index="05" title="Education" id="education">
		{
			education.map((entry, i) => (
				<EducationEntry entry={entry} first={i === 0} />
			))
		}
	</Section>

	<Section index="06" title="Contact" id="contact">
		<p class="contact__lead u-measure-wide" data-reveal>
			Open to co-op terms, and happy to talk about anything above, especially
			the parts that didn't work.
		</p>

		<ul class="contact__list" data-reveal>
			{
				contact.map((channel) => (
					<li class="contact__item">
						<span class="u-label">{channel.label}</span>
						<a class="contact__value" href={channel.href}>
							{channel.value}
						</a>
					</li>
				))
			}
		</ul>

		{/* Revealed through a wrapper: the link has its own hover transition,
		    and marking it directly would let one transition override the other. */}
		<div class="contact__action" data-reveal>
			<a class="contact__resume" href={url('/resume')}>
				Read the resume
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</Section>
</BaseLayout>

<style>
	.contact__lead {
		font-size: var(--fs-md);
		line-height: var(--lh-snug);
	}

	/* Channels are items in one group: spaced from each other by less than
	   the group is spaced from the lead above it. */
	.contact__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-group) var(--space-module);
		margin-block-start: var(--space-group);
		padding-block-start: var(--space-group);
		border-block-start: var(--rule-hair) solid var(--rule);
	}

	/* A label and the address it names are one thing. */
	.contact__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-bound);
	}

	.contact__value {
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		letter-spacing: var(--tr-mono);
	}

	.contact__action {
		margin-block-start: var(--space-group);
	}

	.contact__resume {
		display: inline-flex;
		align-items: center;
		gap: var(--space-related);
		padding: var(--space-related) var(--space-group);
		border: var(--rule-hair) solid var(--ink);
		font-family: var(--font-mono);
		font-size: var(--fs-2xs);
		font-weight: var(--fw-medium);
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease);
	}

	.contact__resume:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* A small nudge on direct interaction. Kept separate from the scroll
	   reveal, which only ever runs once per element. */
	.contact__resume span {
		transition: transform var(--dur-fast) var(--ease);
	}

	.contact__resume:hover span {
		transform: translateX(2px);
	}
</style>
