---
/**
 * One credential. Structurally the same module as a role or a project; the
 * fields differ, which is why the collection is separate, but the shape a
 * reader sees is identical.
 */
import type { CollectionEntry } from 'astro:content';

import LedgerRow from './LedgerRow.astro';
import Entry from './Entry.astro';
import HighlightList from './HighlightList.astro';
import { formatRange, formatRangeLong } from '../lib/dates';

interface Props {
	entry: CollectionEntry<'education'>;
	first?: boolean;
}

const { entry, first = false } = Astro.props;
const { institution, credential, location, start, end, detail } = entry.data;
---

<LedgerRow
	label={formatRange(start, end)}
	sublabel={location}
	rule={!first}
	id={`edu-${entry.id}`}
>
	<Entry
		title={institution}
		subtitle={credential}
		spokenDates={formatRangeLong(start, end)}
	>
		{detail.length > 0 && <HighlightList items={detail} />}
	</Entry>
</LedgerRow>
