---
/**
 * One project: the shared entry module, plus the three things only a project
 * has — a status marker, measured results, and links out to the source.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import LedgerRow from './LedgerRow.astro';
import Entry from './Entry.astro';
import TagList from './TagList.astro';
import HighlightList from './HighlightList.astro';
import StatusChip from './StatusChip.astro';
import MetricGrid from './MetricGrid.astro';
import { formatRange, formatRangeLong } from '../lib/dates';

interface Props {
	entry: CollectionEntry<'projects'>;
	first?: boolean;
}

const { entry, first = false } = Astro.props;
const { title, blurb, status, start, end, stack, repo, demo, highlights, metrics, featured } =
	entry.data;

/** The markdown body is optional — only some entries carry a closing note. */
const { Content } = await render(entry);
const hasNote = entry.body !== undefined && entry.body.trim().length > 0;
---

<LedgerRow label={formatRange(start, end)} rule={!first} id={`proj-${entry.id}`}>
	<Entry
		title={title}
		subtitle={blurb}
		lead={featured}
		spokenDates={formatRangeLong(start, end)}
	>
		{status === 'active' && <StatusChip slot="status" />}

		<TagList items={stack} label="Built with" slot="meta" />

		{metrics.length > 0 && <MetricGrid metrics={metrics} />}

		<HighlightList items={highlights} />

		{
			hasNote && (
				<div class="project__note">
					<Content />
				</div>
			)
		}

		{
			(repo || demo) && (
				<div class="project__links" slot="foot">
					{repo && (
						<a class="project__link" href={repo} rel="noopener">
							Source
							<span class="project__arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)}
					{demo && (
						<a class="project__link" href={demo} rel="noopener">
							Live
							<span class="project__arrow" aria-hidden="true">
								↗
							</span>
						</a>
					)}
				</div>
			)
		}
	</Entry>
</LedgerRow>

<style>
	/* A closing note set against a hairline, for the sentence or two that
	   explains the state of the work rather than its results. */
	.project__note {
		margin-block-start: var(--space-group);
		padding-inline-start: var(--space-group);
		border-inline-start: var(--rule-hair) solid var(--rule);
		max-width: var(--measure-wide);
		font-size: var(--fs-sm);
		line-height: var(--lh-snug);
		color: var(--ink-3);
	}

	.project__note :global(p + p) {
		margin-block-start: var(--space-related);
	}

	.project__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-group);
	}

	.project__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-bound);
		font-family: var(--font-mono);
		font-size: var(--fs-xs);
		font-weight: var(--fw-medium);
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		text-decoration-color: var(--ink-3);
	}

	.project__arrow {
		font-size: 0.9em;
		transition: transform var(--dur-fast) var(--ease);
	}

	/* One pixel of feedback on a direct interaction. */
	.project__link:hover .project__arrow {
		transform: translate(1px, -1px);
	}
</style>
