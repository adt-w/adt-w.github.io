---
/**
 * Project status marker.
 *
 * A small filled square plus a mono label. The square is the only place a
 * solid block of colour appears on the site, which is what makes an active
 * project findable in a long scroll without any animation.
 */

/**
 * Marks work that is still moving. Only rendered for active projects; a
 * finished one says nothing, because "complete" is the assumption a reader
 * already brings to a portfolio.
 */
---

<span class="chip">
	<span class="chip__mark" aria-hidden="true"></span>
	<span class="chip__text">In progress</span>
</span>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		font-family: var(--font-mono);
		font-size: var(--fs-2xs);
		font-weight: var(--fw-medium);
		letter-spacing: var(--tr-label);
		text-transform: uppercase;
		white-space: nowrap;
	}

	.chip__mark {
		width: 0.5em;
		height: 0.5em;
		background-color: currentColor;
	}

	/* The accent is spent here and almost nowhere else. It only means
	   something because so little else carries it. */
	.chip {
		color: var(--accent);
	}
</style>
