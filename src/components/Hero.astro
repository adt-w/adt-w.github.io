---
/**
 * Opening block: the name set as display type, then two ledger rows. The
 * first defines the discipline the role line names; the second is the
 * summary. Both use the page's two-column grid, so the page establishes
 * its one structural idea straight away.
 *
 * The name is never faded in. It is the largest paint on the page, and
 * holding it back would delay the moment the page looks loaded.
 */
import { site, summary, discipline } from '../data/site';
---

<section class="hero" id="summary" aria-labelledby="hero-name">
	<h1 class="hero__name" id="hero-name">Aditya<br />Wadhwa</h1>

	<p class="u-label hero__role" data-reveal>{site.role}</p>

	<div class="hero__row hero__row--definition" data-reveal>
		<div class="hero__aside">
			<span class="u-label">The discipline</span>
		</div>

		<p class="hero__definition">
			<dfn class="hero__term">{discipline.term}</dfn>{discipline.definition}
		</p>
	</div>

	<div class="hero__row" data-reveal>
		<div class="hero__aside">
			<span class="u-label">Summary</span>
		</div>

		<div class="hero__prose">
			{summary.map((paragraph, i) => <p class:list={['hero__p', i === 0 && 'hero__p--lead']}>{paragraph}</p>)}
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block-start: clamp(3rem, 1rem + 8vw, 7rem);
	}

	.hero__name {
		font-size: var(--fs-display);
		font-weight: var(--fw-medium);
		line-height: var(--lh-display);
		letter-spacing: var(--tr-display);
		/* Display type is the one place optical alignment matters enough to
		   pull the block flush with the page edge against its side bearing. */
		margin-inline-start: -0.045em;
	}

	/* The role line belongs to the name above it, so it sits closer to the
	   name than the definition below sits to the role line. */
	.hero__role {
		margin-block-start: var(--space-group);
		padding-block-start: var(--space-related);
		border-block-start: var(--rule-heavy) solid var(--rule-strong);
		color: var(--ink);
	}

	.hero__row {
		display: grid;
		grid-template-columns: var(--col-label) 1fr;
		gap: var(--grid-gap);
		margin-block-start: calc(var(--space-module) / 2);
	}

	/* The definition sits close under the role line it explains, then a
	   hairline hands over to the summary. */
	.hero__row--definition {
		margin-block-start: var(--space-group);
		padding-block-end: calc(var(--space-module) / 2);
		border-block-end: var(--rule-hair) solid var(--rule);
	}

	.hero__row--definition + .hero__row {
		margin-block-start: calc(var(--space-module) / 2);
	}

	.hero__definition {
		max-width: var(--measure-wide);
		color: var(--ink-2);
	}

	/* A <dfn> is italic by default. Here the term is marked by weight and
	   colour instead, which is how emphasis works everywhere else on the page. */
	.hero__term {
		font-style: normal;
		font-weight: var(--fw-medium);
		color: var(--ink);
	}

	.hero__prose {
		max-width: var(--measure-wide);
	}

	.hero__p {
		color: var(--ink-2);
	}

	.hero__p + .hero__p {
		margin-block-start: var(--space-related);
	}

	/* The first paragraph carries slightly more weight and size so the eye
	   has somewhere to land after the display type. */
	.hero__p--lead {
		font-size: var(--fs-md);
		line-height: var(--lh-snug);
		color: var(--ink);
	}

	@media (max-width: 40rem) {
		.hero__row {
			grid-template-columns: 1fr;
			gap: var(--s-3);
		}
	}
</style>
