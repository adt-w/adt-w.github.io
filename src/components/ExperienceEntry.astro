---
/**
 * One role, rendered as the shared entry module inside a ledger row: dates
 * and location in the metadata column, everything else in the content column.
 */
import type { CollectionEntry } from 'astro:content';

import LedgerRow from './LedgerRow.astro';
import Entry from './Entry.astro';
import TagList from './TagList.astro';
import HighlightList from './HighlightList.astro';
import { formatRange, formatRangeLong } from '../lib/dates';

interface Props {
	entry: CollectionEntry<'experience'>;
	/** Suppress the top hairline for the first row in the section. */
	first?: boolean;
}

const { entry, first = false } = Astro.props;
const { org, role, location, start, end, tags, highlights } = entry.data;
---

<LedgerRow
	label={formatRange(start, end)}
	sublabel={location}
	rule={!first}
	id={`exp-${entry.id}`}
>
	<Entry title={org} subtitle={role} spokenDates={formatRangeLong(start, end)}>
		{tags.length > 0 && <TagList items={tags} slot="meta" />}
		<HighlightList items={highlights} />
	</Entry>
</LedgerRow>
